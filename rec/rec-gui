#!/bin/bash
# rec-gui - record the screen with sound, nothing else
#
#   Record   starts recording the whole screen + whatever you hear
#   Stop     ends it; the file is saved in your home folder as video1.mkv,
#            video2.mkv, ... (never overwrites an earlier one)
#
# Tip: run `rec-gui` a second time while recording to stop it - handy
# for a keyboard shortcut, so no window needs to sit on your screen.
# `rec-gui --now` records at once with no windows at all (so nothing of the
# tool ends up in the picture); run `rec-gui` again to stop. Prints the file.
# Audio is always the current default output (@DEFAULT_MONITOR@), so it
# follows your headphones. Video is H.264, audio is lossless FLAC.

# Larger text in the yad windows only (not in ffmpeg etc.)
yad() { GDK_DPI_SCALE=1.3 command yad "$@"; }

pidfile="${XDG_RUNTIME_DIR:-/tmp}/rec-gui.pid"

# Already recording? Then this run is the "stop" request.
if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    kill -INT "$(cat "$pidfile")"
    exit 0
fi

now=0; [ "$1" = --now ] && now=1

tmp=$(mktemp -d)
trap 'rm -rf "$tmp" "$pidfile"' EXIT

while true; do
    if [ $now = 0 ]; then
        yad --center --title="Record" --width=300 --text="Record the screen with sound." \
            --button="Record:0" --button="Close:1" || break
    fi

    n=1
    while [ -e "$HOME/video$n.mkv" ]; do n=$((n + 1)); done
    out="$HOME/video$n.mkv"
    size=$(xdpyinfo | awk '/dimensions:/ {print $2}')

    # Players hold the picture back to match their output's delay, but we hear
    # the sound before that delay - so push the recorded sound later to match.
    case $(pactl get-default-sink) in
        bluez_*) delay=0.26 ;;    # Bluetooth headphones
        *)       delay=0.145 ;;   # wired / speaker
    esac

    ffmpeg -nostdin -y \
        -use_wallclock_as_timestamps 1 -thread_queue_size 1024 -f x11grab -framerate 30 -video_size "$size" -i "$DISPLAY" \
        -use_wallclock_as_timestamps 1 -itsoffset "$delay" -thread_queue_size 1024 -f pulse -i @DEFAULT_MONITOR@ \
        -c:v libx264 -preset veryfast -crf 18 -pix_fmt yuv420p \
        -c:a flac "$out" >/dev/null 2>"$tmp/err" &
    rec=$!
    echo $rec > "$pidfile"

    start=$SECONDS
    if [ $now = 1 ]; then
        wait $rec
    else
    ( while kill -0 $rec 2>/dev/null; do
          t=$((SECONDS - start))
          printf '#Recording...  %02d:%02d\n' $((t / 60)) $((t % 60))
          sleep 1
      done; echo 100 ) |
        yad --progress --pulsate --auto-close --posx=20 --posy=20 --width=300 \
            --title="Recording" --text="Recording screen + sound" \
            --button="Stop:0" 2>/dev/null
    fi

    # Stop pressed (or window closed): finish the file properly.
    kill -INT $rec 2>/dev/null
    wait $rec
    rm -f "$pidfile"

    if [ -s "$out" ]; then
        notify-send "Recording saved" "$out" 2>/dev/null
        [ $now = 1 ] && echo "$out"
    else
        yad --error --center --title="Record" --text="Recording failed:\n$(tail -n 5 "$tmp/err")" --button=OK:0
        rm -f "$out"
    fi
    [ $now = 1 ] && break
done
